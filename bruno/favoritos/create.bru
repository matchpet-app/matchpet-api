meta {
  name: Favoritar pet
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/favoritos
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "petId": "{{petId}}"
  }
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setEnvVar("favoritoId", res.body.id);
  }
}

docs {
  Só ADOTANTE. O adotanteId NÃO vai no body — é derivado do accessToken
  (usuário logado). Precisa que os papéis do accessToken em uso incluam
  adotante e um Adotante já cadastrado pra esse userId.
}
