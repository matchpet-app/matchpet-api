meta {
  name: Criar pet
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/pets
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "nome": "Rex",
    "especie": "cachorro",
    "raca": "SRD",
    "idadeAproximadaMeses": 24,
    "porte": "M",
    "sexo": "macho",
    "corPredominante": "caramelo",
    "nivelEnergia": "moderado",
    "descricao": "Cachorro dócil e brincalhão",
    "saude": {
      "vacinado": true,
      "vermifugado": true,
      "castrado": true,
      "possuiDeficiencia": false
    },
    "compatibilidade": {
      "conviveComCriancas": "sim",
      "conviveComOutrosPets": "nao_testado",
      "conviveComGatos": "nao_testado"
    }
  }
}

vars:pre-request {
  baseUrl: http://localhost:3000
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setEnvVar("petId", res.body.id);
  }
}

docs {
  Só DOADOR. doadorId NÃO vai no body — é derivado do accessToken (o
  Doador do usuário logado). update/remove só o doador dono do pet (ou
  ADMIN) — outros autenticados recebem 403 (não 404, já que a leitura do
  pet é pública).
}
