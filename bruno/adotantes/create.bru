meta {
  name: Criar adotante
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/adotantes
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "nomeCompleto": "Maria Adotante",
    "dataNascimento": "1990-05-10",
    "cpf": "111.444.777-35",
    "telefone": "11999990000",
    "endereco": {
      "cep": "01000-000",
      "uf": "SP",
      "cidade": "São Paulo",
      "bairro": "Centro",
      "logradouro": "Rua das Flores",
      "numero": "100"
    },
    "moradia": {
      "tipo": "casa",
      "posse": "propria",
      "telaProtecao": "sim",
      "composicaoFamiliar": {
        "adultos": 2,
        "criancas": [],
        "outrosPets": []
      }
    }
  }
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setEnvVar("adotanteId", res.body.id);
  }
}

docs {
  userId NÃO vai no body — é derivado do accessToken. Cria o perfil pra
  quem estiver logado no momento (o usuário do accessToken em uso).
  Efeito colateral: se o usuário ainda não tinha role, vira ADOTANTE
  automaticamente (isso É o onboarding). 409 se já for DOADOR.

  findAll/findOne só retornam o próprio perfil, de ADMIN, ou de um doador
  que já tenha uma Adocao com este adotante — qualquer outro caso é 404.
}
