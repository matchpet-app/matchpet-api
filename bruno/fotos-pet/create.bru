meta {
  name: Criar foto de pet
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/fotos-pet
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "petId": "{{petId}}",
    "url": "https://example.com/foto-do-pet.jpg",
    "ordem": 1
  }
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setEnvVar("fotoPetId", res.body.id);
  }
}
